# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Mongo
MONGODB_URI=your_mongodb_connection_string

# Firebase Admin SDK (server-side ID token verification only)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key_with_\n_escaped"

# Demo mode (lets visitors explore without Firebase login)
DEMO_JWT_SECRET=change_this_to_a_long_random_string
DEMO_MODE_ENABLED=true

# Demo/seed only - reminds you which accounts to create
SEED_DEMO_PASSWORD=Demo@12345

# Optional — only needed once you run more than one backend instance behind
# a load balancer. Leave unset for a single-instance demo; Socket.IO falls
# back to its in-memory adapter automatically. When you're ready to scale,
# point this at any managed Redis (Upstash, Redis Cloud, ElastiCache, etc.)
# and restart — no other code changes needed.
# REDIS_URL=redis://default:password@your-redis-host:6379

# ---------------------------------------------------------------------------
# Added in the upgrade — all OPTIONAL unless marked otherwise
# ---------------------------------------------------------------------------

# Demo login gives passwordless access to seeded accounts (incl. admin).
# Defaults to ON in development and OFF in production. Leave "false" for a real launch.
# DEMO_MODE_ENABLED=false

# Anyone signing up with these email domains is automatically marked "verified".
# UNIVERSITY_EMAIL_DOMAINS=youruni.edu,students.youruni.edu

# Comma-separated words to block in posts/comments/messages (empty = none).
# BLOCKED_WORDS=

# Logging: debug | info | warn | error
# LOG_LEVEL=info

# Run the in-process background jobs (event reminders). Set false on all but one instance.
# RUN_JOBS=true

# Image uploads (Cloudinary). Either one URL...
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ...or the three parts:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email notifications (any SMTP provider: Resend, Brevo, Gmail app password, SES, ...)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="UniConnect <no-reply@yourdomain.com>"

# Web push notifications. Generate keys once with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com
