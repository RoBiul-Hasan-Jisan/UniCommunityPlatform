# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Mongo
MONGODB_URI=your_mongodb_connection_string

# Firebase Admin SDK (server-side ID token verification only)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key_with_\n_escaped"

# Demo mode (lets visitors explore without Firebase login)
DEMO_JWT_SECRET=change_this_to_a_long_random_string
DEMO_MODE_ENABLED=true

# Demo/seed only - reminds you which accounts to create
SEED_DEMO_PASSWORD=Demo@12345

# Optional — only needed once you run more than one backend instance behind
# a load balancer. Leave unset for a single-instance demo; Socket.IO falls
# back to its in-memory adapter automatically. When you're ready to scale,
# point this at any managed Redis (Upstash, Redis Cloud, ElastiCache, etc.)
# and restart — no other code changes needed.
# REDIS_URL=redis://default:password@your-redis-host:6379
